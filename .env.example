# Claude powers the hypothesis agent, RCA narratives, the rubric judge and the triage tier-3 resolver.
# Without it EPOCH runs fully offline with heuristic agents and a local kNN resolver.
ANTHROPIC_API_KEY=
EPOCH_AGENT_MODEL=claude-sonnet-5
EPOCH_JUDGE_MODEL=claude-haiku-4-5-20251001

# Storage (defaults to SQLite in .epoch/). docker-compose sets Postgres + pgvector, Redis and MLflow.
# EPOCH_DB_URL=postgresql+psycopg://epoch:epoch@localhost:5432/epoch
# EPOCH_REDIS_URL=redis://localhost:6379/0
# EPOCH_MLFLOW_URI=http://localhost:5000
# EPOCH_OTLP_ENDPOINT=http://localhost:4318/v1/traces

# $/hour of the serving hardware used in the cost objective (auto: configs/pricing.yaml)
# EPOCH_HW_PRICE_PER_HOUR=0.45
